# Copy this to `.env` and fill in real values. NEVER commit `.env`.
# HOSTING_APP_KEY unlocks the encrypted launcher (main.py). Generate a strong
# one, e.g.: python -c "import secrets;print(secrets.token_hex(16))"
HOSTING_APP_KEY=your_strong_random_app_key
HOSTING_BOT_TOKEN=your_telegram_bot_token_from_botfather
HOSTING_OWNER_ID=your_telegram_user_id

# TiDB Cloud (multi-cluster mirroring): primary DSN first.
HOSTING_DB_DRIVER=tidb
HOSTING_TIDB_DSNS=mysql://user:password@host:4000/hostingdb,mysql://user2:password2@host2:4000/hostingdb

# Optional
HOSTING_SUB_LINK=https://t.me/your_bot
HOST_URL=https://your-app.onrender.com
PORT=7860